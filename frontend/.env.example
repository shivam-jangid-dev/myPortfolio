# Copy this file to .env and fill in your values.
# Never commit the real .env — it is in .gitignore.

# ── API ────────────────────────────────────────────────────────────────────────
# URL of the FastAPI backend server.
# Local dev default (matches uvicorn default port in backend/main.py):
# VITE_API_BASE_URL=http://localhost:8080

# Production — set this to your deployed backend URL, e.g.:
VITE_API_BASE_URL=https://portfolio-backend-z32n.onrender.com
