# Copy this file to .env and fill in your values.
# Never commit the real .env — it is in .gitignore.

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
# Required. Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional. Defaults to groq/llama-3.3-70b-versatile if not set.
# LLM_MODEL_NAME=groq/llama-3.3-70b-versatile

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Required in production — set this in your Railway environment variables.
# ALLOWED_ORIGINS=https://your-portfolio.vercel.app,https://yourdomain.com

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Override locally if needed.
# PORT=8080
